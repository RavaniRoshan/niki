{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "merged": {
      "type": "object",
      "description": "The reconciled change, shaped exactly like a single coder's CodeDiff.",
      "properties": {
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "search": {
                "type": "string",
                "description": "Verbatim text copied EXACTLY from the Current File Contents (whitespace and indentation included, 3-5+ lines so the match is unique)."
              },
              "replace": {
                "type": "string",
                "description": "Replacement text that takes the place of 'search' verbatim."
              }
            },
            "required": ["search", "replace"]
          }
        },
        "files_changed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "action": {
                "type": "string",
                "enum": ["create", "modify", "delete"]
              },
              "language": {
                "type": ["string", "null"]
              }
            },
            "required": ["path", "action"]
          }
        },
        "implementation_notes": { "type": "string" },
        "spec_adherence": { "type": "string" },
        "uncertainties": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Risks, open questions, or assumptions made under time pressure."
        }
      },
      "required": [
        "edits",
        "files_changed",
        "implementation_notes",
        "spec_adherence"
      ],
      "additionalProperties": false
    },
    "reconciliation_notes": { "type": "string" },
    "sources_merged": { "type": "integer", "minimum": 1 }
  },
  "required": [
    "merged",
    "reconciliation_notes",
    "sources_merged"
  ],
  "additionalProperties": false
}
