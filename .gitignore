research/

# Dev-only and temporary demo scripts
demo.sh
# VHS tapes for marketing assets are tracked; only ignore ad-hoc ones.
*.tape
!assets/tapes/*.tape
scripts/render_demo_terminal.py
scripts/generate_screenshots.py
scripts/render_buffers.py

# Reference screenshots, images, and attachments — root level only.
# We use `/` prefixes so the rules only match the project root, not
# any subdirectory like assets/screenshots/ (where we want the
# marketing assets tracked).
/Screenshot*
/screenshot*
# Catch-all for loose image files at the project root.
/*.png
/*.gif
/*.jpg
/*.jpeg
/*.webp
/*.mp4

# Marketing assets: tracked in repo so the README/docs can embed them.
!assets/*.svg
!assets/*.png
!assets/*.gif
!assets/*.mp4
!assets/screenshots/*.png
!assets/screenshots/*.gif
!assets/social/*.png

*Zone.Identifier*
*.identifier

# Internal strategy docs — not for the public repo
CLOUD_BACKEND_SPEC.md
BUILD_PLAN.md
10x-deep-research.md
problem-statements.md
docs/screenshots/

# Temporary files and scratch logs
*.tmp
*.bak
*.swp
*.log
