# Headless NIKI agent container for Harbor and benchmark evaluation (GHCR).
# Packages the static headless niki engine with base tools for containerized benchmarks.

FROM rust:1.88-alpine AS builder

RUN apk add --no-cache musl-dev git perl make

WORKDIR /build
COPY . .

ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo build --release --bin niki

FROM alpine:3.20

RUN apk add --no-cache \
    bash \
    git \
    curl \
    python3 \
    py3-pip \
    ca-certificates

COPY --from=builder /build/target/release/niki /usr/local/bin/niki
RUN chmod +x /usr/local/bin/niki

WORKDIR /workspace

ENTRYPOINT ["niki", "agent"]
CMD ["--help"]
