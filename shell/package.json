{
  "name": "@niki/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The NIKI terminal shell. A pure client: it speaks niki-protocol and never talks to an engine API directly.",
  "bin": {
    "niki-shell": "./src/cli.tsx"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "test": "npm run test:unit && npm run test:pty",
    "test:watch": "vitest --exclude 'test/pty.test.ts' --exclude 'test/fixture-loop.test.tsx' --exclude 'test/roundtrip-latency.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "gen:bindings": "cp ../crates/niki-protocol/bindings/*.ts src/protocol/generated/ 2>/dev/null || true",
    "gen:keymap": "tsx scripts/gen-keymap.ts",
    "check:keymap": "tsx scripts/gen-keymap.ts --check",
    "test:unit": "vitest run --exclude 'test/pty.test.ts' --exclude 'test/fixture-loop.test.tsx' --exclude 'test/roundtrip-latency.test.ts'",
    "test:pty": "vitest run test/pty.test.ts && vitest run test/fixture-loop.test.tsx && vitest run test/roundtrip-latency.test.ts"
  },
  "dependencies": {
    "ink": "^6.0.1",
    "react": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
