name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

env:
  CARGO_TERM_COLOR: always

jobs:
  build:
    name: Build ${{ matrix.target }}
    runs-on: ubuntu-latest
    strategy:
      matrix:
        include:
          - target: x86_64-unknown-linux-gnu
            os: ubuntu-latest
          - target: x86_64-apple-darwin
            os: macos-latest
          - target: aarch64-apple-darwin
            os: macos-latest
    steps:
      - uses: 11d5960a326750d5838078e36cf38b85af677262
      - uses: 4360b52568e2003a75bf9bc1d59f33a8e3fc893c
        with:
          targets: ${{ matrix.target }}
      - uses: 49a0bdc70d2e1b713ca9e2869b211fcce03d3c1c
        with:
          key: ${{ matrix.target }}

      - name: Build release binary
        run: cargo build --release --target ${{ matrix.target }}

      - name: Create archive
        run: |
          BINARY=niki-${{ github.ref_name }}-${{ matrix.target }}
          mv target/${{ matrix.target }}/release/niki ${BINARY}
          tar czf ${BINARY}.tar.gz ${BINARY}
          sha256sum ${BINARY}.tar.gz > ${BINARY}.tar.gz.sha256

      - name: Upload artifact
        uses: ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: niki-${{ matrix.target }}
          path: |
            niki-${{ github.ref_name }}-${{ matrix.target }}.tar.gz
            niki-${{ github.ref_name }}-${{ matrix.target }}.tar.gz.sha256

  release:
    name: Create Release
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          path: artifacts
          merge-multiple: true

      - name: Create GitHub Release
        uses: 3bb12739c298aeb8a4eeaf626c5b8d85266b0e65
        with:
          draft: false
          prerelease: false
          generate_release_notes: true
          files: artifacts/*.tar.gz
